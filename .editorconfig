# Shared whitespace and encoding rules for editors used by project contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces can be an intentional Markdown line break.
trim_trailing_whitespace = false
